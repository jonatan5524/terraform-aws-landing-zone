# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude terraform.tfvars and other secrets
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to git
# !override.tf

# Include lock file for providers
.terraform.lock.hcl

# Ignore CLI configuration files
.terraformrc
terraform.rc

docs/superpowers/*

# Local MCP config — contains personal AWS profile names
.mcp.json
